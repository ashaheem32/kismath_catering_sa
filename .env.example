# Copy to `.env` and fill in your details. `.env` is gitignored.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
# Gmail App Password (Account → Security → 2-Step Verification → App passwords).
# 16 chars, paste with spaces removed.
SMTP_PASS=xxxxxxxxxxxxxxxx

TO_EMAIL=your-address@gmail.com
TO_NAME=Your Business Name
